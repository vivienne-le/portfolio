---
import Base from '../layouts/Base.astro';
import PhotoAlbums from '../components/PhotoAlbums.astro';
import ToggleList from '../components/ToggleList.astro';
import { site, contact, aboutToggles } from '../data/site.js';
---
<Base title={`About · ${site.name}`} current="about">
  <article class="col about">
    <div class="marks">
      {site.logo && <img class="logo" src={site.logo} alt={`${site.name} logo`} width="56" height="56" />}
      {site.photo && <img class="logo photo" src={site.photo} alt={`Photo of ${site.name}`} width="56" height="56" tabindex="0" />}
    </div>
    <h1 id="about-me">About me</h1>
    <div class="photos"><PhotoAlbums /></div>
    <p>I’m Vivienne, a UX design student at The Hague University of Applied Sciences. At Decathlon Netherlands I work on search and AI growth: I design visual assets that guide people through complex information, and I shape content so it’s easier to find for both search engines and large language models.</p>
    <p>What drives me is how humans and computers understand each other, and how design can make technology feel intuitive and calm. Outside of work I build small creative tech projects that mix design and code, and I’m learning Python and math simply because I enjoy learning.</p>
    <p>After my bachelor’s I want to do a master’s in Human-Computer Interaction, to go deeper into research on how people interact with technology and how interactive systems are designed.</p>
    <div class="more-about"><ToggleList items={aboutToggles} /></div>
    <p>I’m always happy to talk about UX, HCI or creative tech. You can find me on <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a> or use the yellow note in the corner.</p>
  </article>
</Base>

<style>
  .about { display: grid; }
  .photos { margin: 4px 0 32px; }
  .more-about { margin: 18px 0 30px; }
  h1 { font-size: var(--text-l); letter-spacing: -0.02em; margin-bottom: 20px; }
  /* Same photo as on the home page: grows on hover (or tap / keyboard focus) */
  .marks { display: flex; gap: 12px; margin-bottom: 22px; position: relative; z-index: 5; }
  .logo { width: 56px; height: 56px; border-radius: 16px; object-fit: contain; }
  .photo {
    object-fit: cover; position: relative; cursor: zoom-in;
    transform-origin: top left; transition: transform var(--d-object) var(--spring), box-shadow var(--d-move), border-radius var(--d-move);
  }
  .photo:hover, .photo:focus-visible, .photo.big {
    transform: scale(3.2) rotate(-2deg); border-radius: 8px; z-index: 10;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1), 0 18px 40px -12px rgba(0, 0, 0, 0.45);
  }
  .photo:focus-visible { outline: 2px solid var(--dot); outline-offset: 1px; }
</style>

<script>
  // Touch screens: tap the photo to make it bigger, tap anywhere to shrink it again
  const photo = document.querySelector('.about .photo');
  if (photo) {
    photo.addEventListener('click', (e) => { if (matchMedia('(hover: none)').matches) { e.stopPropagation(); photo.classList.toggle('big'); } });
    document.addEventListener('click', () => photo.classList.remove('big'));
  }
</script>
