---
// Emoji cursors: give any element data-cursor="💻" and, with a mouse,
// the pointer turns into that emoji while hovering it.
// An image works too: data-cursor="/images/my-picture.png" (any image file).
// Add data-cursor-dark="…" for a different cursor in dark mode.
// Links and buttons inside keep the normal pointer.
---
<span class="emoji-cursor" aria-hidden="true"></span>

<style>
  .emoji-cursor {
    position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none;
    font-size: 24px; line-height: 1; opacity: 0;
    translate: var(--cx, -100px) var(--cy, -100px);
    transform: translate(-50%, -50%) scale(0.6);
    transition: opacity 120ms ease-out, transform var(--d-move) var(--spring);
  }
  .emoji-cursor :global(img) { display: block; width: auto; height: auto; max-height: 40px; max-width: 140px; }
  .emoji-cursor.on { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-6deg); }
  :global([data-cursor].emoji-active), :global([data-cursor].emoji-active *) { cursor: none; }
  :global([data-cursor].emoji-active a), :global([data-cursor].emoji-active button) { cursor: pointer; }
</style>

<script>
  const el = document.querySelector('.emoji-cursor');
  const place = (e) => { el.style.setProperty('--cx', `${e.clientX}px`); el.style.setProperty('--cy', `${e.clientY}px`); };
  document.querySelectorAll('[data-cursor]').forEach((target) => {
    target.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      // data-cursor-dark: an optional different cursor for dark mode
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const c = (dark && target.dataset.cursorDark) || target.dataset.cursor;
      if (/\.(png|jpe?g|gif|svg|webp|avif)$/i.test(c)) el.innerHTML = `<img src="${c}" alt="">`; else el.textContent = c;
      place(e);
      target.classList.add('emoji-active');
      el.classList.add('on');
    });
    target.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      place(e);
      el.classList.toggle('on', !e.target.closest('a, button'));
    });
    target.addEventListener('pointerleave', () => {
      target.classList.remove('emoji-active');
      el.classList.remove('on');
    });
  });
</script>
