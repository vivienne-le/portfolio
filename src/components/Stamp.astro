---
// A post stamp that crops any photo into its perforated shape.
// Without a src it shows a striped photo placeholder.
const { src = null, alt = '', label = 'your photo', class: cls = '' } = Astro.props;
---
<span class={`stamp-wrap ${cls}`}>
  <span class="stamp" style="width:100%;height:100%">
    {src ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <span class="ph" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-8 9"/></svg>
        <span>{label}</span>
      </span>
    )}
  </span>
</span>
