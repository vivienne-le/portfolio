---
// Footer: local time, the binary-year easter egg, links, and a terminal for the curious.
import { site, contact, currently } from '../data/site.js';
const year = String(site.designingSince);
const bin = Number(year).toString(2);
const thisYear = new Date().getFullYear(); // updates itself each time the site is built
// What the "now" command prints, taken from `currently` in site.js so it works on every page
const nowLines = currently.items.map((i) => `${i.label}: ${i.value}`);
---
<footer class="col foot">
  <div class="row">
    <span class="since" tabindex="0" data-year={year} data-bin={bin}>
      building since <span class="yr" aria-label={year}>{bin}</span>
    </span>
    <span class="clock label" data-tz={site.timeZone} data-loc={site.locationLabel}>{site.locationLabel}</span>
  </div>
  <div class="row">
    <nav class="links" aria-label="Elsewhere">
      <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={contact.cv} target="_blank" rel="noopener">CV</a>
      <a href={`mailto:${contact.email}`}>Email</a>
    </nav>
    <button class="term-toggle label" type="button" aria-expanded="false" aria-controls="terminal">› terminal</button>
  </div>
  <p class="copy label">© {thisYear} {site.name}. Designed and built by me.</p>

  <div class="terminal" id="terminal" data-now={JSON.stringify(nowLines)} hidden>
    <div class="term-head"><span>guest@vivienne:~</span><button type="button" class="term-close" aria-label="Close terminal">esc</button></div>
    <div class="term-out" aria-live="polite"><p>type <b>help</b> to see what I can do</p></div>
    <form class="term-form" autocomplete="off">
      <label for="term-in" class="sr-only">Terminal command</label>
      <span aria-hidden="true">$</span>
      <input id="term-in" type="text" spellcheck="false" autocapitalize="off" />
    </form>
  </div>
</footer>

<style>
  .foot { margin-top: var(--section); padding-top: 22px; border-top: 1px solid var(--line); display: grid; gap: 14px; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .since { color: var(--ink-2); font-size: 0.9rem; cursor: default; border-radius: 6px; }
  .yr { font: 500 0.88rem/1 var(--mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .yr :global(.z) { color: var(--ink-3); opacity: 0.6; }
  .copy { margin: 0; }
  .links { display: flex; gap: 16px; font-size: 0.88rem; }
  .links a { color: var(--ink-2); }
  .term-toggle { background: none; border: 0; cursor: pointer; padding: 4px 0; }
  .term-toggle:hover { color: var(--ink); }
  .terminal {
    background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--radius-m); overflow: hidden;
    font: 400 0.8rem/1.6 var(--mono);
  }
  .term-head { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .term-close { font: inherit; font-size: 0.72rem; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; padding: 2px 8px; cursor: pointer; color: var(--ink-2); }
  .term-out { padding: 10px 12px 0; max-height: 220px; overflow-y: auto; color: var(--ink-2); }
  .term-out :global(p) { margin: 0 0 4px; color: var(--ink-2); }
  .term-out :global(.cmd) { color: var(--ink); }
  .term-form { display: flex; gap: 8px; padding: 6px 12px 12px; color: var(--ink-3); }
  .term-form input { flex: 1; min-width: 0; font: inherit; color: var(--ink); background: none; border: 0; outline: 0; caret-color: var(--dot); }
</style>

<script>
  import { tick, setSound, isSoundOn, reduceMotion } from '../scripts/sound.js';

  // Local time
  const clock = document.querySelector('.clock');
  const fmt = () => {
    try {
      const t = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: clock.dataset.tz }).format(new Date());
      clock.textContent = `${clock.dataset.loc} · ${t}`;
    } catch {}
  };
  fmt(); setInterval(fmt, 30000);

  // Binary year: decodes digit by digit on hover or focus
  const since = document.querySelector('.since');
  const yr = since.querySelector('.yr');
  const year = since.dataset.year, bin = since.dataset.bin, L = bin.length;
  let timer = null;
  function decode() {
    clearInterval(timer);
    if (reduceMotion()) { yr.textContent = year; return; }
    const target = year.padStart(L, '0').split('');
    let step = 0;
    timer = setInterval(() => {
      step++;
      yr.innerHTML = target.map((d, i) => {
        if (step >= 4 + i * 2) return (d === '0' && i < L - year.length) ? `<span class="z">0</span>` : d;
        return Math.random() < 0.5 ? '0' : '1';
      }).join('');
      if (step >= 4 + L * 2) { clearInterval(timer); yr.textContent = year; tick(2000); }
    }, 38);
  }
  const encode = () => { clearInterval(timer); yr.textContent = bin; };
  since.addEventListener('mouseenter', decode); since.addEventListener('focus', decode);
  since.addEventListener('mouseleave', encode); since.addEventListener('blur', encode);
  since.addEventListener('click', () => (yr.textContent === year ? encode() : decode()));

  // Terminal
  const toggle = document.querySelector('.term-toggle');
  const term = document.getElementById('terminal');
  const out = term.querySelector('.term-out');
  const form = term.querySelector('.term-form');
  const input = term.querySelector('#term-in');
  const open = (v) => {
    term.hidden = !v; toggle.setAttribute('aria-expanded', String(v));
    if (v) { input.focus(); tick(1600); }
  };
  toggle.addEventListener('click', () => open(term.hidden));
  term.querySelector('.term-close').addEventListener('click', () => { open(false); toggle.focus(); });
  term.addEventListener('keydown', (e) => { if (e.key === 'Escape') { open(false); toggle.focus(); } });

  // Confetti for the secret: a rainbow burst from both bottom corners.
  // Skipped for visitors who prefer reduced motion.
  function confetti() {
    if (reduceMotion()) return;
    [1800, 2100, 2500].forEach((p, i) => setTimeout(() => tick(p), i * 90));
    const cv = document.createElement('canvas');
    cv.setAttribute('aria-hidden', 'true');
    cv.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:100';
    document.body.appendChild(cv);
    const dpr = Math.min(2, devicePixelRatio || 1), W = innerWidth, H = innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    const ctx = cv.getContext('2d'); ctx.scale(dpr, dpr);
    // Rainbow: red, orange, yellow, green, blue, indigo, violet
    const colours = ['#ff3b30', '#ff9500', '#ffcc00', '#34c759', '#0a84ff', '#5856d6', '#af52de'];
    const rand = (a, b) => a + Math.random() * (b - a);
    const bits = [];
    for (const side of [0, 1]) for (let k = 0; k < 90; k++) {
      const ang = side ? rand(200, 250) : rand(-70, -20);   // shoot up and inwards
      const sp = rand(9, 17);
      bits.push({
        x: side ? W + 10 : -10, y: H * rand(0.75, 1),
        vx: Math.cos(ang * Math.PI / 180) * sp, vy: Math.sin(ang * Math.PI / 180) * sp,
        w: rand(6, 11), h: rand(8, 15), r: rand(0, 6.28), vr: rand(-0.25, 0.25),
        c: colours[Math.floor(Math.random() * colours.length)], shape: Math.random() < 0.25 ? 'dot' : 'rect',
        wob: rand(0, 6.28),
      });
    }
    const t0 = performance.now();
    const frame = (now) => {
      const t = (now - t0) / 1000;
      ctx.clearRect(0, 0, W, H);
      for (const b of bits) {
        b.vy += 0.32; b.vx *= 0.985; b.vy *= 0.985; b.wob += 0.15;
        b.x += b.vx + Math.sin(b.wob) * 0.6; b.y += b.vy; b.r += b.vr;
        ctx.save(); ctx.globalAlpha = Math.max(0, 1 - Math.max(0, t - 2.4) / 0.8);
        ctx.translate(b.x, b.y); ctx.rotate(b.r); ctx.fillStyle = b.c;
        if (b.shape === 'dot') { ctx.beginPath(); ctx.arc(0, 0, b.w / 2, 0, 7); ctx.fill(); }
        else ctx.fillRect(-b.w / 2, -b.h / 2 * Math.abs(Math.cos(b.wob)), b.w, b.h * Math.abs(Math.cos(b.wob)));
        ctx.restore();
      }
      if (t < 3.3) requestAnimationFrame(frame); else cv.remove();
    };
    requestAnimationFrame(frame);
  }

  const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
  const print = (html) => { const p = document.createElement('p'); p.innerHTML = html; out.appendChild(p); out.scrollTop = out.scrollHeight; };
  // Invite the visitor for a drink: the contact note waves and gets a sticker
  const invite = (drink) => {
    window.dispatchEvent(new CustomEvent('note:attention', { detail: { sticker: drink } }));
    return drink === 'matcha'
      ? 'matcha date? 🍵 my treat. say hi through the yellow note ↗'
      : 'coffee’s on me ☕ let’s chat. say hi through the yellow note ↗';
  };
  const commands = {
    help: () => 'about · now · contact · sound · coffee · matcha · secret · clear',
    about: () => 'UX design student at THUAS. Search & AI at Decathlon. Heading for an HCI master’s.',
    now: () => JSON.parse(document.getElementById('terminal').dataset.now).map(esc).join('<br>'),
    contact: () => { window.dispatchEvent(new CustomEvent('note:attention')); return 'over here ↗ the yellow note has everything'; },
    sound: () => { setSound(!isSoundOn()); return `sound ${isSoundOn() ? 'on' : 'off'}`; },
    coffee: () => invite('coffee'),
    matcha: () => invite('matcha'),
    secret: () => { const on = document.documentElement.classList.toggle('party'); if (on) { confetti(); return 'cheers to finding my portfolio'; } return 'party’s over. type secret to start it again'; },
    clear: () => { out.innerHTML = ''; window.dispatchEvent(new CustomEvent('note:clear')); return null; },
  };
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const raw = input.value.trim(); input.value = '';
    if (!raw) return;
    const cmd = raw.replace(/^\//, '').toLowerCase();
    print(`<span class="cmd">$ ${esc(raw)}</span>`);
    const res = commands[cmd] ? commands[cmd]() : `command not found: ${esc(cmd)}. try help`;
    if (res) print(res);
    tick(1500);
  });
</script>
