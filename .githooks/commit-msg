#!/bin/sh
# Keeps Vivienne the only author: removes co-author and AI attribution lines from the commit message.
msg="$1"
grep -viE '^(co-authored-by:|claude-session:|.*generated with .*claude)' "$msg" > "$msg.tmp" || true
# drop trailing blank lines left behind
sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$msg.tmp" > "$msg"
rm -f "$msg.tmp"
